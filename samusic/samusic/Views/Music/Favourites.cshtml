@model List<samusic.Models.FavouriteSong>

@{
    // Sets page title for the favourites page
    ViewData["Title"] = "My Favourites";
}

<div class="musicPage">
    @* Displays main page heading *@
    <h1>My Favourites</h1>

    @* Displays success message when a favourite has been removed *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="pageMessage successMessage">
            @TempData["SuccessMessage"]
        </div>
    }

    @* Hidden section used to display details of the selected favourite *@
    <section id="selectedFavouriteSection" class="contentSection" style="display: none;">
        <div class="sectionHeader">
            <h2>Selected Favourite</h2>
        </div>
        <div id="selectedFavouriteDetails"></div>
    </section>

    @* Displays message if the user has not saved any songs *@
    @if (!Model.Any())
    {
        <p>You have not saved any songs yet.</p>
    }
    else
    {
        @* Displays all favourited songs as selectable cards *@
        <div class="searchResultsGrid">
            @foreach (var song in Model)
            {
                <div class="musicCard searchCard favouriteSelectableCard"
                     onclick="selectFavouriteCard(this)"
                     data-id="@song.Id"
                     data-track-name="@song.TrackName"
                     data-artist-names="@song.ArtistNames"
                     data-album-name="@song.AlbumName"
                     data-album-image-url="@song.AlbumImageUrl"
                     data-spotify-url="@song.SpotifyUrl"
                     data-release-date="@song.ReleaseDate"
                     data-spotify-track-id="@song.SpotifyTrackId">

                    <img src="@song.AlbumImageUrl" alt="@song.TrackName" />
                    <h4>@song.TrackName</h4>
                    <p>@song.ArtistNames</p>
                    <p><strong>Album:</strong> @song.AlbumName</p>
                    <p><strong>Release date:</strong> @song.ReleaseDate</p>

                    @* Provides actions for opening the track in Spotify or removing it from favourites *@
                    <div class="favouriteCardActions" onclick="event.stopPropagation();">
                        <a href="@song.SpotifyUrl" target="_blank" class="openSpotifyLink">
                            Open in Spotify
                        </a>

                        <form asp-controller="Music" asp-action="RemoveFavourite" method="post">
                            <input type="hidden" name="id" value="@song.Id" />
                            <button type="submit" class="removeButton">
                                Remove from favourites
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Loads JavaScript file for selecting favourite cards *@
<script src="~/js/favourites.js"></script>