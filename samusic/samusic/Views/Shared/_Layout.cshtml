<!DOCTYPE html>
<html lang="en">
<head>
    @* Sets the character encoding and ensures the page scales correctly on different devices *@
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* Displays the page title followed by the site name *@
    <title>@ViewData["Title"] - samusic</title>

    @* Loads stylesheets used across the whole site *@
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/samusic.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @* Displays main site navigation bar *@
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">samusic</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Music" asp-action="Index">Music</a>
                        </li>

                        @* Shows favourites and reviews links only for logged-in users *@
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Music" asp-action="Favourites">My Favourites</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Music" asp-action="MyReviews">My Reviews</a>
                            </li>
                        }
                    </ul>

                    @* Displays login and account links *@
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    @* Main page content is rendered here *@
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* Displays footer at the bottom of the page *@
    <footer class="footer">
        <div class="container">
            &copy; 2026 - samusic - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    @* Loads JavaScript files used across the site *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Allows individual pages to load extra scripts when needed *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>